PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
NODE_ENV=production
# SMTP для кодов подтверждения почты
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pulse <no-reply@example.com>
# Опциональный TURN-сервер для надёжного WebRTC за строгим NAT
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
