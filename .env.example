PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
NODE_ENV=production
# SMTP для кодов подтверждения почты
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pulse <no-reply@example.com>
# Опциональный TURN-сервер для надёжного WebRTC за строгим NAT
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
# OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Публичный адрес без завершающего слеша
PUBLIC_URL=https://your-app.onrender.com
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
